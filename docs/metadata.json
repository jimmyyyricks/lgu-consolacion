			"__js": "\n\n/* Adding apps/ci_eam/ci_eam/asset_management/doctype/asset_class/asset_class.js */\n\n// Copyright (c) 2024, Frappe Technologies and contributors\n// For license information, please see license.txt\n\nfrappe.ui.form.on(\"Asset Class\", {\n\tequipment(frm) {\n        frm.set_query('parent_asset_class_id', () => {\n            return {\n                filters: {\n                    equipment: frm.doc.equipment\n                }\n            }\n        });\n\t},\n\n    after_save(frm) {\n        if (frm.doc.parent_asset_class_id != null && frm.doc.parent_asset_class_id != \"\") {\n            populateAssetClassPropAndMaintPlan(frm);\n        }\n    }\n});\n\nfunction populateAssetClassPropAndMaintPlan(frm) {\n    frm.call({\n        method: 'ci_eam.asset_management.doctype.asset_class.asset_class.populate_asset_class_prop_and_maint_plan',\n        args: { 'asset_class': frm.doc.name, 'parent_asset_class': frm.doc.parent_asset_class_id, 'asset_class_name': frm.doc.class_name },\n        callback: function(response) {\n            console.log(\"success\", response);\n            \n            if (response.message.status === \"Error\") {\n                frappe.msgprint({\n                    title: __('Warning'),\n                    indicator: 'red',\n                    message: __(`${response.message.error_message}`)\n                });\n            }\n        },\n        error: (r) => {\n            console.log(\"error\", r);\n\n            frappe.msgprint({\n                title: __('Warning'),\n                indicator: 'red',\n                message: __(`Failed to duplicate asset class property and maintenance plan from parent asset class.`)\n            });\n        }    \n    });\n}\n\n//# sourceURL=asset_class__js",
