# ============================================================
# EAM System — Environment Variables
# ============================================================
# Copy to backend/.env (the backend reads .env from its own directory).
# Only DATABASE_URL is required; everything else has sensible defaults.

# ── Database (required) ──────────────────────────────────────
# Async driver (used by the app):
DATABASE_URL=postgresql+asyncpg://eam_dev:EamDev2026Dev@localhost:5432/eam_local_dev
# Sync driver (used by Alembic migrations — auto-derived if omitted):
# DATABASE_URL_SYNC=postgresql://eam_dev:EamDev2026Dev@localhost:5432/eam_local_dev

# Bootstrap URL: a superuser connection used ONLY during install to create the
# app role and database. Defaults to OS-user peer auth (works on macOS/Homebrew
# and Linux where the current user is a PostgreSQL superuser). Override if needed:
# DATABASE_BOOTSTRAP_URL=postgresql:///postgres

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend ─────────────────────────────────────────────────
# Set this in the shell or in frontend/.env
# NUXT_PUBLIC_API_URL=http://localhost:8010/api

# ── CORS ─────────────────────────────────────────────────────
# JSON array of allowed origins (defaults cover localhost:3000-3002)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# SOCKETIO_CORS_ORIGINS=["http://localhost:3000"]

# ── Email / SMTP (optional) ─────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM_ADDRESS=your-email@gmail.com
# EMAIL_FROM_NAME=EAM Notifications
# EMAIL_ENABLED=false

# ── File Uploads ─────────────────────────────────────────────
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_MB=10

# ── Seeds (development only) ────────────────────────────────
# RUN_SEEDS=false

# ── Installer-only PostgreSQL bootstrap (optional) ──────────
# Use this when the app role/database does not exist yet.
# DATABASE_BOOTSTRAP_URL=postgresql://postgres:postgres@localhost:5432/postgres

# The first administrator is created during install or via the setup wizard.
# Example:
# ./install.sh --admin-username admin --admin-email admin@example.com --admin-full-name "System Administrator" --admin-password "change-me"
